---
/**
 * Pain card — a soft callout for "biz problem", "user pain", a numbered
 * insight, etc. Borderless, sits on a barely-there grey fill, title + body.
 * The `tag` prop is accepted for back-compat but no longer rendered (eyebrows
 * removed globally).
 */
interface Props {
  tag?: string;
  title: string;
}
const { title } = Astro.props;
---

<article class="pain">
  <h4 class="title">{title}</h4>
  <div class="body">
    <slot />
  </div>
</article>

<style>
  .pain {
    background: #f6f7fa;
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .title {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
  }
  .body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }
  /* Slotted MDX wraps body text in its own <p>, which otherwise inherits the
     global `.dc-body p { margin: 0 0 16px }` rule and leaves dead air at the
     bottom of the card. Zero it; space stacked paragraphs instead. */
  .body :global(p) { margin: 0; }
  .body :global(p + p) { margin-top: var(--space-3); }
</style>

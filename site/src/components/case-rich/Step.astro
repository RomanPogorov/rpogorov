---
/**
 * Protocol step — one compact row inside a <Protocol>: a bold title, a body
 * line, and an optional badge pill (e.g. "экономия контекста: …" or a
 * checkpoint note). The badge splits on the first ":" so the label reads
 * muted and the value reads in accent. No numbering, no left rail — dense by
 * design. Reusable across any step-by-step narrative.
 */
interface Props {
  title: string;
  badge?: string;
}
const { title, badge } = Astro.props;
const colon = badge ? badge.indexOf(':') : -1;
const badgeLabel = colon > -1 ? badge!.slice(0, colon + 1) : null;
const badgeVal = colon > -1 ? badge!.slice(colon + 1).trim() : badge ?? null;
---

<div class="step">
  <h4 class="step-title">{title}</h4>
  <p class="step-body"><slot /></p>
  {badge && (
    <span class="step-badge">
      {badgeLabel && <span class="b-label">{badgeLabel}</span>}
      <span class="b-val">{badgeVal}</span>
    </span>
  )}
</div>

<style>
  .step {
    padding-block: var(--space-4);
  }
  .step:not(:first-child) {
    border-top: 1px solid var(--border-soft);
  }
  .step-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .step-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    margin-top: var(--space-2);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    background: rgba(var(--acc-rgb), 0.08);
    border: 1px solid rgba(var(--acc-rgb), 0.18);
    font-family: var(--font-mono);
    font-size: var(--type-2xs);
    line-height: 1.4;
  }
  .b-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .b-val {
    color: var(--acc);
    font-weight: 600;
  }
</style>

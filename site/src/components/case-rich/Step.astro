---
/**
 * Protocol step — one compact row inside a <Protocol>: a bold title and a
 * body line, with an optional badge rendered inline at the end of the body
 * as a <code> chip (styled identically to inline code like
 * `references/catalog.md` via content.css). No numbering, no left rail, no
 * extra badge line — dense by design. Reusable across step-by-step narratives.
 */
interface Props {
  title: string;
  badge?: string;
}
const { title, badge } = Astro.props;
---

<div class="step">
  <h4 class="step-title">{title}</h4>
  <p class="step-body"><slot />{badge && <code class="step-badge">{badge}</code>}</p>
</div>

<style>
  .step {
    background: #f6f7fa;
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .step-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  /* visual style inherited from content.css `.cnt-body code`; flush-left on
     its own wrapped line, small breath above. */
  .step-badge {
    display: inline-block;
    margin-top: var(--space-2);
    margin-left: 0;
  }
</style>

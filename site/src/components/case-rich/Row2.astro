---
/**
 * Row2 — two images side-by-side, each with its own caption. Mobile
 * collapses to single column. Renders inside `.dc-grid-2` (legacy
 * 2-column grid). Each image is a `.dc-figure` so the lightbox handler
 * picks it up.
 *
 * Usage in MDX:
 *   <Row2 items={[
 *     { src: '/.../a.png', alt: 'A', caption: '// option A' },
 *     { src: '/.../b.png', alt: 'B', caption: '// option B' },
 *   ]} portrait />
 */
type Item = { src: string; alt?: string; caption?: string; kind?: 'image' | 'video'; poster?: string };
interface Props {
  items: Item[];
  portrait?: boolean;
  /** Opt-in faint grey border + 8px radius on each image (for flat,
   *  edge-to-edge UI screenshots that otherwise read as borderless). */
  framed?: boolean;
}
const { items, portrait = false, framed = false } = Astro.props;
const figClass = portrait ? 'dc-figure dc-figure-portrait' : 'dc-figure';
const cleanCap = (c?: string) => c?.replace(/^\s*\/\/\s*/, '');
---
<div class:list={['dc-grid-2', { 'is-framed': framed }]}>
  {items.map((it) => {
    const cap = cleanCap(it.caption);
    return (
      <figure class={figClass} data-media data-kind={it.kind ?? 'image'} data-src={it.src} data-caption={cap ?? ''}>
        {it.kind === 'video' ? (
          <video src={it.src} poster={it.poster} autoplay muted loop playsinline preload="none"></video>
        ) : (
          <img loading="lazy" decoding="async" src={it.src} alt={it.alt ?? ''} />
        )}
        {cap && <figcaption>{cap}</figcaption>}
      </figure>
    );
  })}
</div>

<style>
  .dc-grid-2.is-framed :global(img),
  .dc-grid-2.is-framed :global(video) {
    border: 1px solid rgba(15, 20, 25, 0.08);
    border-radius: 8px;
  }
</style>

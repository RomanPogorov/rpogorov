---
/**
 * Principle — a single card inside <Principles>: a short accent rule, a bold
 * title, and a slotted body paragraph. Clean, icon-free. Reusable for any
 * "ideas the thing rests on" grid.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="principle">
  <span class="principle-bar" aria-hidden="true"></span>
  <h4 class="principle-title">{title}</h4>
  <p class="principle-body"><slot /></p>
</article>

<style>
  .principle {
    background: var(--surface-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .principle-bar {
    display: block;
    width: 28px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--acc);
    margin-bottom: var(--space-4);
  }
  .principle-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .principle-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .principle-body :global(strong) {
    color: var(--text-strong);
    font-weight: 600;
  }
</style>
